# /etc/freecher/freecher.env  —  chmod 600, owned by root:freecher
#
# systemd reads this file as plain KEY=VALUE: no quoting, no shell expansion,
# no inline comments after a value. Secrets live only here; nothing in the repo.

# ---- Cloudflare R2 (required) ----------------------------------------------
FREECHER_R2_BUCKET=freecher
FREECHER_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
FREECHER_R2_ACCESS_KEY_ID=<access-key-id>
FREECHER_R2_SECRET_ACCESS_KEY=<secret-access-key>
FREECHER_R2_PUBLIC_BASE_URL=https://<public-bucket>.r2.dev

# ---- Media tooling (required) ----------------------------------------------
# MUST be a build with libass, or every render fails loudly at the subtitle
# stage. Ubuntu 24.04's ffmpeg package qualifies; verify with `preflight`.
FREECHER_FFMPEG_PATH=/usr/bin/ffmpeg
FREECHER_FFPROBE_PATH=/usr/bin/ffprobe

# ---- Job store (required) --------------------------------------------------
# Must match --jobs-dir in both unit files. Survives restarts and reboots.
FREECHER_JOBS_DIR=/var/lib/freecher/jobs

# ---- Transcription placement -----------------------------------------------
# The Oracle ARM VM has no CUDA. 'auto' runs short audio on CPU and hands
# anything longer to the GPU host through R2; 'remote' always hands off.
FREECHER_TRANSCRIBE_BACKEND=auto
FREECHER_CPU_TRANSCRIPTION_MAX_SECONDS=900
FREECHER_ALLOW_CPU_TRANSCRIPTION=false
# Decoding config the GPU host is asked to use (T4 profile).
FREECHER_TRANSCRIBE_MODEL=large-v3
FREECHER_TRANSCRIBE_DEVICE=cuda
FREECHER_TRANSCRIBE_COMPUTE_TYPE=float16

# ---- Ingest ----------------------------------------------------------------
# Cap source height to keep a 3-hour VOD from filling a 45 GB boot volume.
FREECHER_INGEST_MAX_HEIGHT=720
FREECHER_INGEST_CONCURRENCY=4

# ---- Scoring (optional; the heuristic scorer runs without it) ---------------
# FREECHER_LLM_API_KEY=
# FREECHER_LLM_BASE_URL=
# FREECHER_LLM_MODEL=
