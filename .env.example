# ASR Configuration
ARNY_ASR_MODEL=small
ARNY_ASR_DEVICE=cuda
ARNY_ASR_COMPUTE_TYPE=int8_float16
ARNY_ASR_BEAM_SIZE=5
ARNY_ASR_VAD_FILTER=true
ARNY_ASR_LANGUAGE=ru

# Highlight & Window Settings
ARNY_HIGHLIGHT_MIN_SECONDS=30
ARNY_HIGHLIGHT_TARGET_SECONDS=60
ARNY_HIGHLIGHT_MAX_SECONDS=90
ARNY_HIGHLIGHT_TOP_K=5
ARNY_HIGHLIGHT_OVERLAP_SECONDS=15
ARNY_DEDUP_OVERLAP_THRESHOLD=0.60
ARNY_CLIP_PADDING_SECONDS=2.0

# Scorer Configuration ("heuristic" or "llm")
ARNY_SCORER=heuristic

# Optional OpenAI-compatible LLM Scorer
ARNY_LLM_BASE_URL=
ARNY_LLM_API_KEY=
ARNY_LLM_MODEL=gpt-4o-mini

# Paths
ARNY_OUTPUT_DIR=runs

# Optional HuggingFace Token
HF_TOKEN=
