# ASR Configuration
FREECHER_ASR_MODEL=small
FREECHER_ASR_DEVICE=cuda
FREECHER_ASR_COMPUTE_TYPE=int8_float16
FREECHER_ASR_BEAM_SIZE=5
FREECHER_ASR_VAD_FILTER=true
FREECHER_ASR_LANGUAGE=ru

# Highlight & Window Settings
FREECHER_HIGHLIGHT_MIN_SECONDS=30
FREECHER_HIGHLIGHT_TARGET_SECONDS=60
FREECHER_HIGHLIGHT_MAX_SECONDS=90
FREECHER_HIGHLIGHT_TOP_K=5
FREECHER_HIGHLIGHT_OVERLAP_SECONDS=15
FREECHER_DEDUP_OVERLAP_THRESHOLD=0.60
FREECHER_CLIP_PADDING_SECONDS=2.0

# Scorer Configuration ("heuristic" or "llm")
FREECHER_SCORER=heuristic

# Optional OpenAI-compatible LLM Scorer
FREECHER_LLM_BASE_URL=
FREECHER_LLM_API_KEY=
FREECHER_LLM_MODEL=gpt-4o-mini

# Streaming Ingest — Cloudflare R2 (YouTube -> R2, nothing staged on disk)
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_PUBLIC_BASE_URL=
FREECHER_INGEST_QUALITY=best
FREECHER_INGEST_PART_SIZE_MB=16
FREECHER_INGEST_CONCURRENCY=4
FREECHER_INGEST_KEY_TEMPLATE=input/{video_id}/source.mp4

# Transcription-ready audio cut from the same stream, written beside the video
# at processing/{video_id}/audio.m4a. Mono at ASR sample rate, not archival.
FREECHER_INGEST_EXTRACT_AUDIO=true
FREECHER_INGEST_AUDIO_CODEC=aac
FREECHER_INGEST_AUDIO_SAMPLE_RATE=16000
FREECHER_INGEST_AUDIO_CHANNELS=1
FREECHER_INGEST_AUDIO_BITRATE=64k

# GPU transcription of the R2 audio artifact (processing/{id}/audio.m4a ->
# transcript.json). Separate from FREECHER_ASR_* above, which drives the local
# `process` pipeline; these target a single NVIDIA T4.
FREECHER_TRANSCRIBE_MODEL=large-v3
FREECHER_TRANSCRIBE_DEVICE=cuda
FREECHER_TRANSCRIBE_COMPUTE_TYPE=float16
FREECHER_TRANSCRIBE_BEAM_SIZE=5
FREECHER_TRANSCRIBE_VAD_FILTER=true
FREECHER_TRANSCRIBE_WORD_TIMESTAMPS=true

# Paths
FREECHER_OUTPUT_DIR=runs

# Optional HuggingFace Token
HF_TOKEN=
